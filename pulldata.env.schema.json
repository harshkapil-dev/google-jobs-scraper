{
  "variables": [
    {
      "key": "GOOGLE_JOBS_PROXY_URL",
      "required": false,
      "secret": true,
      "description": "Optional authenticated HTTP(S) residential gateway URL. Use this or the Webshare settings; proxying is required."
    },
    {
      "key": "WEBSHARE_RESIDENTIAL_PROXY_URL",
      "required": false,
      "secret": true,
      "description": "Optional existing Webshare authenticated residential gateway URL."
    },
    {
      "key": "WEBSHARE_RESIDENTIAL_PROXY_HOST",
      "required": false,
      "secret": false,
      "description": "Webshare residential gateway hostname."
    },
    {
      "key": "WEBSHARE_RESIDENTIAL_PROXY_PORT",
      "required": false,
      "secret": false,
      "description": "Webshare residential gateway port."
    },
    {
      "key": "WEBSHARE_RESIDENTIAL_PROXY_USERNAME",
      "required": false,
      "secret": true,
      "description": "Webshare residential gateway username."
    },
    {
      "key": "WEBSHARE_RESIDENTIAL_PROXY_PASSWORD",
      "required": false,
      "secret": true,
      "description": "Webshare residential gateway password."
    },
    {
      "key": "PULLDATA_WORKER_TOKEN",
      "required": false,
      "secret": true,
      "description": "Optional bearer token protecting readiness, scrape, status and result routes."
    },
    {
      "key": "GOOGLE_JOBS_PROXY_SESSION_MODE",
      "required": false,
      "secret": false,
      "description": "Use rotating (default) for server proxies; sticky explicitly enables a per-job session on a compatible residential gateway."
    }
  ]
}
