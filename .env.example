# Configure one residential proxy securely. Values belong only in runtimeEnv.
GOOGLE_JOBS_PROXY_URL=
WEBSHARE_RESIDENTIAL_PROXY_HOST=
WEBSHARE_RESIDENTIAL_PROXY_PORT=
WEBSHARE_RESIDENTIAL_PROXY_USERNAME=
WEBSHARE_RESIDENTIAL_PROXY_PASSWORD=
# Local tests only. Deployed workers require platform Redis and queue namespace.
GOOGLE_JOBS_ALLOW_MEMORY_STORE=true

GOOGLE_JOBS_PROXY_SESSION_MODE=rotating
